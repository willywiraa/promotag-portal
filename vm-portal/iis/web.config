<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS in front of the Promo Tag Portal (DEPLOY-VM.md, step 10). Copy this file to the IIS application's
  folder, e.g. C:\inetpub\promotag, and add the application to the site that answers the address you
  use (for http://<vm-ip>/promotag/: the site bound to that IP on port 80). IIS only forwards requests:
  the portal itself runs in the signed-in user's session (start-portal.cmd), because it drives a
  visible Edge window.
  Needs URL Rewrite and Application Request Routing, with "Enable proxy" on.
  If the portal uses another port (PTAE_PORT), change 8080 below.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Ignore rewrite rules inherited from the site this application sits in (e.g. WatsonTester). -->
        <clear />
        <!-- /promotag -> /promotag/ : the portal's pages use relative links. -->
        <rule name="Promo Tag Portal: trailing slash" stopProcessing="true">
          <match url="^$" />
          <conditions>
            <add input="{URL}" pattern="/$" negate="true" />
          </conditions>
          <action type="Redirect" url="{URL}/" redirectType="Found" />
        </rule>
        <rule name="Promo Tag Portal: forward" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8080/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <!-- Live run updates are a stream; compressing it would hold it back. -->
    <urlCompression doDynamicCompression="false" />
  </system.webServer>
</configuration>
